-- fence powershell
& 'C:\Users\u\.tokendrop\bin\dropin-miner.exe' agents prefer -config 'C:\Users\u\.tokendrop\tokendrop.toml' <argument>
-- fence bash
'C:\Users\u\.tokendrop\bin\dropin-miner.exe' search -config 'C:\Users\u\.tokendrop\tokendrop.toml' -format model "<query>"
