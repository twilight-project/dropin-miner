# Every string each host is handed on windows, as this binary renders it.
# Characterization (H1): v0.2.9's renderings; H2 and H3 change them as reviewed diffs.
binary: C:\Users\u\.tokendrop\bin\dropin-miner.exe
config: C:\Users\u\.tokendrop\tokendrop.toml

