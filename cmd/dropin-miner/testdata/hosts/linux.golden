"/home/u/.tokendrop/bin/dropin-miner" hook -config "/home/u/.tokendrop/tokendrop.toml" window post-compact
"\"/home/u/.tokendrop/bin/dropin-miner\" hook -config \"/home/u/.tokendrop/tokendrop.toml\" window post-compact"
