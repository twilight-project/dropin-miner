== cursor: beforeShellExecution recognizer grammar on linux
-- skill search block
refused
-- stdin command alone
argv ["/home/u/.tokendrop/bin/dropin-miner" "search" "-config" "/home/u/.tokendrop/tokendrop.toml" "--stdin"]
-- preference command
argv ["/home/u/.tokendrop/bin/dropin-miner" "agents" "prefer" "-config" "/home/u/.tokendrop/tokendrop.toml" "status"]
-- human form
argv ["/home/u/.tokendrop/bin/dropin-miner" "search" "-config" "/home/u/.tokendrop/tokendrop.toml" "-format" "model" "exact query text"]

