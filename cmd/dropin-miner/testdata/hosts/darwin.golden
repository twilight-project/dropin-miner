-- rule
Bash("/Users/u/.tokendrop/bin/dropin-miner" search -config "/Users/u/.tokendrop/tokendrop.toml":*)
"Bash(\"/Users/u/.tokendrop/bin/dropin-miner\" search -config \"/Users/u/.tokendrop/tokendrop.toml\":*)"
-- rule
Bash(/Users/u/.tokendrop/bin/dropin-miner search -config "/Users/u/.tokendrop/tokendrop.toml":*)
