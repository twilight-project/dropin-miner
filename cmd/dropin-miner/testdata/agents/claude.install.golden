      "content": "{\n  \"hooks\": {\n    \"PostCompact\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"\\\"/home/u/.tokendrop/bin/dropin-miner\\\" hook -config \\\"/home/u/.tokendrop/tokendrop.toml\\\" window post-compact\",\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"PreCompact\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"\\\"/home/u/.tokendrop/bin/dropin-miner\\\" hook -config \\\"/home/u/.tokendrop/tokendrop.toml\\\" window pre-compact\",\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"\\\"/home/u/.tokendrop/bin/dropin-miner\\\" hook -config \\\"/home/u/.tokendrop/tokendrop.toml\\\" lineage\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"Bash\"\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"\\\"/home/u/.tokendrop/bin/dropin-miner\\\" hook -config \\\"/home/u/.tokendrop/tokendrop.toml\\\" window session-start\",\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"\\\"/home/u/.tokendrop/bin/dropin-miner\\\" hook -config \\\"/home/u/.tokendrop/tokendrop.toml\\\" flush\",\n            \"type\": \"command\"\n          }\n        ]\n      }\n    ]\n  },\n  \"permissions\": {\n    \"allow\": [\n      \"Bash(\\\"/home/u/.tokendrop/bin/dropin-miner\\\" search -config \\\"/home/u/.tokendrop/tokendrop.toml\\\":*)\",\n      \"Bash(/home/u/.tokendrop/bin/dropin-miner search -config \\\"/home/u/.tokendrop/tokendrop.toml\\\":*)\"\n    ]\n  }\n}\n"
